{
  "name": "priorityskills-monorepo",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.11.0",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "typescript": "^5.2.2",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "install:all": "pnpm install",
    "test": "pnpm -r run test",
    "build": "pnpm -r run build",
    "cli:scan": "pnpm --filter priorityskills run build && pnpm --filter priorityskills exec -- node ./dist/index.js scan --root ."
  },
  "type": "module"
}
